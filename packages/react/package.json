{
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Tijori contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adithya2310/Tijori.git"
  },
  "homepage": "https://github.com/Adithya2310/Tijori#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "name": "@tijori/react",
  "description": "Tijori React components: object sign-in, Whitechain vaults, co-present approvals, acoustic attendance and the drop-in <TijoriApp/>.",
  "exports": {
    ".": {
      "@tijori/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./*": {
      "@tijori/source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@tijori/core": "0.1.0",
    "@tijori/client": "0.1.0",
    "lucide-react": "^1.69.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "viem": "^2.57.16"
  }
}
