# Server-only: never use NEXT_PUBLIC_ prefixes or paste secrets into chat.
ARKIV_WALLET_PRIVATE_KEY=0x_REPLACE_LOCALLY
ARKIV_WALLET_ADDRESS=0x66330597bD0a67B970CF32F003a70444CEB27c34
# Obtain your own free RPC access key at https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
# Independent encryption key: 32 cryptographically random bytes as 64 hex characters.
# Back it up privately; losing it makes the state unreadable.
ARKIV_STATE_ENCRYPTION_KEY=
ARKIV_NAMESPACE=tichori-local-v1
# Explicit cumulative maximum reservation across this namespace's durable journal.
# No paid writes are permitted until a positive amount is configured.
ARKIV_MAX_TOTAL_FEE_TGLM=0
# All server processes using this signer MUST share this persistent directory.
# VAULT_DATA_DIR=/absolute/path/to/data

# --- Whitechain treasury (server-only) ---
# Optional RPC override (e.g. your Ankr hacker endpoint). Default: https://rpc.testnet.whitechain.io
# WHITECHAIN_RPC_URL=
# Relayer: pays WBT gas for vault creation and attested payouts. Dedicated key; fund from the faucet.
# Create with `cast wallet new` and paste here yourself. Never reuse the Arkiv or deployer key.
WHITECHAIN_RELAYER_PRIVATE_KEY=
# Verifier: signs co-presence attestations that TichoriPresenceGuard requires. Separate key, no funds.
TICHORI_VERIFIER_PRIVATE_KEY=
# Addresses printed by `forge script script/Deploy.s.sol` (see README, Whitechain section).
TICHORI_GUARD_ADDRESS=
TICHORI_SAFE_SETUP_ADDRESS=
# 32 random bytes (hex) for vendor inbox keys and webhook secrets. Defaults to a key derived from
# ARKIV_STATE_ENCRYPTION_KEY when unset. Rotating it invalidates every issued inbox key.
# TICHORI_API_MASTER_KEY=
# Allow webhooks to localhost/private networks (needed for the local vendor example).
# TICHORI_WEBHOOK_ALLOW_PRIVATE=1
# Vault-paid gas refund in micro-USDT per gas (0 disables), base gas, fee cap, floors and caps.
# TREASURY_GAS_PRICE_MICRO_USDT=1
# TREASURY_BASE_GAS=80000
# RELAYER_MAX_FEE_GWEI=20
# RELAYER_MIN_BALANCE_MILLI_WBT=5
# RELAYER_DAILY_VAULT_DEPLOYS=20
# RELAYER_DAILY_EXECUTIONS_PER_VAULT=25
# APPROVAL_SESSION_SECONDS=120
