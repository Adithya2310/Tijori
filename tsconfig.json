{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tijori/core": [
        "./packages/core/src/index.ts"
      ],
      "@tijori/core/*": [
        "./packages/core/src/*"
      ],
      "@tijori/server": [
        "./packages/server/src/index.ts"
      ],
      "@tijori/server/*": [
        "./packages/server/src/*"
      ],
      "@tijori/client": [
        "./packages/client/src/index.ts"
      ],
      "@tijori/client/*": [
        "./packages/client/src/*"
      ],
      "@tijori/react": [
        "./packages/react/src/index.ts"
      ],
      "@tijori/react/*": [
        "./packages/react/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "customConditions": [
      "@tijori/source"
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts",
    ".next-phone/types/**/*.ts",
    ".next-phone/dev/types/**/*.ts",
    ".next-phone-build/types/**/*.ts",
    ".next-phone-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "contracts",
    "packages/*/dist",
    "examples/*/node_modules",
    "examples/*/.next"
  ]
}
