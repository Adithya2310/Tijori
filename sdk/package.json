{
  "name": "tijori-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Development workspace for the @tijori/* npm packages. The Tijori app at the repository root consumes the published releases.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/client packages/react && node scripts/postbuild-packages.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@tijori/source --experimental-strip-types --test tests/*.test.ts tests/modem.test.mjs && node --conditions=@tijori/source --experimental-strip-types tests/flow.mjs",
    "test:whitechain": "forge build --root ../contracts && node --conditions=@tijori/source --experimental-strip-types tests/whitechain-flow.mjs",
    "arkiv": "node --conditions=@tijori/source --experimental-strip-types packages/server/src/cli.ts arkiv",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "calibrate": "node --conditions=@tijori/source --experimental-strip-types scripts/calibrate.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "ggwave": "^0.4.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "viem": "^2.57.16"
  }
}
